# ================================================
# AegisLink Work — Configuración compartida
# Copia este archivo a .env y ajusta los valores.
# NUNCA comitear .env con valores reales.
# Las variables se documentan en docs/DEVELOPMENT.md y docs/DEPLOYMENT-MODES.md;
# esta plantilla crece en la fase 2 (semilla técnica) cuando exista server/.
# ================================================

# ---- Modo de despliegue (docs/DEPLOYMENT-MODES.md) ----
# multi  = SaaS multi-organización operado por AegisLink
# single = una sola organización, self-hosted (docs/SELF-HOSTING.md)
TENANCY=single

# ---- Work relay ----
PORT=3001
# Secreto para los tokens de descarga de blobs. OBLIGATORIO en producción:
# sin él el relay falla cerrado al arrancar. Genera con: openssl rand -hex 32
BLOB_SECRET=change-me-use-openssl-rand-hex-32
# CORS bloqueado al dominio propio en producción. Vacío = fail-closed (nunca '*').
CORS_ORIGIN=
# 1 = hay un proxy delante (nginx/caddy). 0 = sin proxy.
TRUST_PROXY=1
DATABASE_URL=./data/aegislink-work.db
# Para PostgreSQL:
# DATABASE_URL=postgres://user:pass@localhost:5432/aegislink_work

# ---- TURN/STUN (coturn self-hosted; llamadas 1:1) ----
# TURN_SECRET es COMPARTIDO entre el relay (firma) y coturn (verifica).
TURN_HOST=
TURN_PORT=3478
TURN_SECRET=change-me-use-openssl-rand-hex-32

# ---- Clientes ----
# Android emulator → http://10.0.2.2:3001 · iOS simulator / desktop → http://localhost:3001
EXPO_PUBLIC_SERVER_URL=http://10.0.2.2:3001
VITE_RELAY_URL=http://localhost:3001

# ---- Aviso de versión a los clientes (cero metadatos) ----
# El relay publica estos valores, idénticos para todos; nunca recibe la versión del cliente.
APP_LATEST_VERSION=
APP_MIN_VERSION=
